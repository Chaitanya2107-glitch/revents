APP_NAME=College Event Management API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://college_events:CHANGE_DB_PASSWORD@localhost:5432/college_events
JWT_SECRET_KEY=REPLACE_WITH_INDEPENDENT_SECURE_RANDOM_JWT_SECRET
TICKET_SECRET_KEY=REPLACE_WITH_INDEPENDENT_SECURE_RANDOM_TICKET_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated override for multiple frontend origins.
CORS_ORIGINS=
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_COLLEGE_EMAIL_DOMAINS=college.edu
CANCELLATION_CUTOFF_HOURS=2
CHECKIN_BEFORE_MINUTES=60
CHECKIN_AFTER_MINUTES=60
TICKET_PRESENTATION_TTL_MINUTES=1440
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGE_PIXELS=20000000
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Leave SMTP_HOST empty to explicitly disable email password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRE_MINUTES=30

